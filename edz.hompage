<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Calorie Calculator - Your Path to a Healthier You</title>
  <script src="https://kit.fontawesome.com/your-font-awesome-kit-id.js" crossorigin="anonymous"></script>
  <style>
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      color: #e0e0e0;
      line-height: 1.6;
      background: linear-gradient(120deg, #1e1e1e 0%, #2a2a2a 100%);
    }

    /* HEADER */
    header {
      background: #111;
      padding: 20px 0;
      border-bottom: 2px solid #2e7d32;
      text-align: center;
      position: relative;
    }
    header .logo {
      font-size: 2em;
      font-weight: bold;
      color: #81c784;
      letter-spacing: 1.5px;
    }
    .header-btn {
      position: absolute;
      top: 20px;
      right: 20px;
      background: linear-gradient(135deg,#43a047 80%,#66bb6a 100%);
      color: #fff;
      padding: 10px 22px;
      text-decoration: none;
      border-radius: 8px;
      font-size: 1em;
      font-weight: 500;
      box-shadow: 0 2px 8px rgba(0,0,0,0.4);
      transition: background 0.3s, transform 0.2s;
    }
    .header-btn:hover {
      background: linear-gradient(135deg,#2e7d32 80%,#43a047 100%);
      transform: scale(1.05);
    }

    /* HERO SECTION */
    .hero {
      background: url('images/healthy-bg.jpg') no-repeat center center/cover;
      color: #fff;
      text-align: center;
      padding: 100px 20px;
      position: relative;
      z-index: 1;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.7);
      z-index: -1;
    }
    .hero h1 {
      font-size: 3em;
      margin-bottom: 20px;
      text-shadow: 2px 2px 8px rgba(0,0,0,0.7);
    }
    .hero p {
      font-size: 1.2em;
      margin-bottom: 30px;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
      color: #e0e0e0;
    }
    .hero .cta-button {
      display: inline-block;
      background: linear-gradient(135deg,#43a047 80%,#66bb6a 100%);
      color: white;
      padding: 15px 30px;
      text-decoration: none;
      border-radius: 8px;
      font-size: 1.1em;
      font-weight: 500;
      box-shadow: 0 2px 8px rgba(0,0,0,0.4);
      transition: background 0.3s, transform 0.2s;
    }
    .hero .cta-button:hover {
      background: linear-gradient(135deg,#2e7d32 80%,#388e3c 100%);
      transform: scale(1.05);
    }

    /* SECTIONS */
    .section {
      padding: 60px 20px;
      text-align: center;
      background: #1e1e1e;
    }
    .section:nth-of-type(odd) {
      background: #242424;
    }
    .section h2 {
      font-size: 2.2em;
      margin-bottom: 40px;
      color: #81c784;
    }

    /* FEATURE ITEMS */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 30px;
      margin-top: 40px;
    }
    .feature-item {
      background: #2e2e2e;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.6);
      transition: transform 0.3s;
    }
    .feature-item:hover {
      transform: translateY(-5px) scale(1.03);
    }
    .feature-item img {
      width: 80px;
      height: 80px;
      margin-bottom: 20px;
      filter: drop-shadow(2px 2px 4px rgba(0,0,0,0.3));
    }
    .feature-item h3 {
      font-size: 1.3em;
      margin-bottom: 10px;
      color: #81c784;
    }
    .feature-item p {
      font-size: 1em;
      color: #cfcfcf;
    }

    /* HOW IT WORKS */
    .how-it-works-steps {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 40px;
      margin-top: 40px;
    }
    .step-item {
      flex: 1 1 300px;
      padding: 30px;
      background: #2b2b2b;
      border-radius: 10px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.6);
      text-align: left;
      position: relative;
    }
    .step-item .step-number {
      font-size: 2.2em;
      font-weight: bold;
      color: #4caf50;
      position: absolute;
      top: 15px;
      left: 20px;
      opacity: 0.3;
    }
    .step-item h3 {
      font-size: 1.3em;
      margin-top: 0;
      margin-bottom: 15px;
      color: #a5d6a7;
      padding-left: 50px;
    }
    .step-item p {
      font-size: 1em;
      color: #ccc;
    }

    /* FOOTER */
    footer {
      background: linear-gradient(90deg, #1b5e20 60%, #388e3c 100%);
      color: #e0e0e0;
      padding: 60px 20px;
      text-align: center;
    }
    footer .cta-footer {
      font-size: 2em;
      margin-bottom: 30px;
      color: #c8e6c9;
    }
    footer .cta-footer .cta-button {
      background: linear-gradient(135deg,#43a047 80%,#66bb6a 100%);
      color: white;
      padding: 15px 30px;
      text-decoration: none;
      border-radius: 8px;
      font-size: 1.1em;
      font-weight: 500;
      box-shadow: 0 2px 8px rgba(0,0,0,0.4);
      transition: background 0.3s, transform 0.2s;
    }
    footer .cta-footer .cta-button:hover {
      background: linear-gradient(135deg,#2e7d32 80%,#388e3c 100%);
      transform: scale(1.05);
    }

    footer .footer-links a {
      color: #bdbdbd;
      text-decoration: none;
    }
    footer .footer-links a:hover {
      color: #a5d6a7;
    }
    footer .social-icons a {
      color: #bdbdbd;
      text-decoration: none;
      margin: 0 8px;
    }
    footer .social-icons a:hover {
      color: #a5d6a7;
    }
    footer .copyright {
      margin-top: 40px;
      font-size: 0.9em;
      color: #a5d6a7;
    }

    /* CHATBOT */
    #chatbot-float {
      background: #43a047;
    }
    #chatbot-popup {
      background: #2a2a2a;
      color: #fff;
    }
    #chatbot-input {
      border: 1px solid #66bb6a;
      background: #1c1c1c;
      color: #fff;
    }
    #chatbot-popup h3 {
      color: #81c784;
    }

    @media (max-width: 768px) {
      .hero h1 {
        font-size: 2em;
      }
      .hero p {
        font-size: 1em;
      }
      .section h2 {
        font-size: 1.5em;
      }
    }
  </style>
</head>
<body>
<head>
    
       <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Calorie Calculator - Your Path to a Healthier You</title>
  <script src="https://kit.fontawesome.com/your-font-awesome-kit-id.js" crossorigin="anonymous"></script>
  <style>
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      color: #e0e0e0;
      line-height: 1.6;
      background: linear-gradient(120deg, #1e1e1e 0%, #2a2a2a 100%);
    }

    /* --- Chatbot styles (moved here correctly) --- */
    #chatbot-float {
      position: fixed;
      bottom: 32px;
      right: 32px;
      z-index: 9999;
      background: #4a90e2;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      box-shadow: 0 4px 16px rgba(0,0,0,0.18);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: box-shadow 0.2s;
    }

    #chatbot-popup {
      position: fixed;
      bottom: 100px;
      right: 32px;
      z-index: 10000;
      width: 320px;
      background: #f0f4f8;
      border-radius: 16px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.18);
      padding: 18px;
      display: none;
    }

    #chatbot-window {
      height: 140px;
      overflow-y: auto;
      background: #fff;
      border-radius: 8px;
      border: 1px solid #e0e0e0;
      padding: 10px;
      margin-bottom: 10px;
      font-size: 0.98em;
    }

    #chatbot-input {
      flex: 1;
      padding: 8px;
      border-radius: 6px;
      border: 1px solid #4a90e2;
    }
    /* --- End of Chatbot styles --- */

    /* (keep all your other CSS below) */
  </style>
</head>
<body>


    <header>
        <div class="container">
            <div class="logo">Calorie Calculator</div>
            <a href="login.html" class="header-btn">Login / Sign Up</a>
        </div>
    </header>

    <main>
        <section class="hero">
            <div class="container">
                <h1>Calculate Your Way to a Healthier You</h1>
                <p>Unlock your nutritional goals with personalized insights and smart meal planning. Start your journey to a balanced life today!</p>
                <a href="javascript:void(0);" class="cta-button" id="startCalcBtn">Start Calculating Now</a>
            </div>
        </section>

        <section class="section features-section">
            <div class="container">
                <h2>Key Features</h2>
                <div class="features-grid">
                    <div class="feature-item">
                        <img src="https://via.placeholder.com/80x80?text=Insights" alt="Personalized Insights Icon">
                        <h3>Personalized Insights</h3>
                        <p>Get tailored calorie and nutrition recommendations based on your unique profile and goals.</p>
                    </div>
                    <div class="feature-item">
                        <img src="https://via.placeholder.com/80x80?text=Meals" alt="Meal Planning Icon">
                        <h3>Meal Planning</h3>
                        <p>Discover delicious and healthy meal ideas that fit your dietary needs and preferences.</p>
                    </div>
                    <div class="feature-item">
                        <img src="images/progress tracking.png" alt="Progress Tracking Icon">
                        <h3>Progress Tracking</h3>
                        <p>Monitor your progress with intuitive charts and reports to stay motivated on your journey.</p>
                    </div>
                    <div class="feature-item">
                        <img src="https://via.placeholder.com/80x80?text=Database" alt="Food Database Icon">
                        <h3>Extensive Food Database</h3>
                        <p>Access a vast database of foods with detailed nutritional information for accurate tracking.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="section how-it-works-section">
            <div class="container">
                <h2>How It Works</h2>
                <div class="how-it-works-steps">
                    <div class="step-item">
                        <div class="step-number">1</div>
                        <h3>Enter Your Details</h3>
                        <p>Quickly input your basic information, activity level, and health goals to get started.</p>
                    </div>
                    <div class="step-item">
                        <div class="step-number">2</div>
                        <h3>Get Your Results</h3>
                        <p>Receive an instant breakdown of your daily calorie needs and personalized nutrient targets.</p>
                    </div>
                    <div class="step-item">
                        <div class="step-number">3</div>
                        <h3>Achieve Your Goals</h3>
                        <p>Use our tools to track your meals, plan your diet, and stay on course to a healthier you.</p>
                    </div>
                </div>
            </div>
        </section>

        <div id="calculatorContainer" style="display:none; opacity:0; transition:opacity 0.7s;">
            <!-- Calculator will be loaded here -->
        </div>
    </main>

    <footer>
        <div class="container">
            <div class="cta-footer">
                Ready to take control of your health? 
                <a href="login.html" class="cta-button">Join Calorie Calculator Today!</a>
            </div>

            <div class="footer-links">
                <ul>
                    <li><a href="#about">About Us</a></li>
                    <li><a href="#features">Features</a></li>
                    <li><a href="#testimonials">Testimonials</a></li>
                    <li><a href="#blog">Blog</a></li>
                    <li><a href="#contact">Contact</a></li>
                    <li><a href="#privacy">Privacy Policy</a></li>
                    <li><a href="#terms">Terms of Service</a></li>
                </ul>
            </div>

            <div class="social-icons">
                <a href="#facebook" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                <a href="#twitter" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                <a href="#instagram" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                <a href="#linkedin" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            </div>

            <div class="copyright">
                &copy; 2025 Calorie Calculator. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- Floating AI Chatbot Icon -->
    <div id="chatbot-float" style="
      position:fixed;
      bottom:32px;
      right:32px;
      z-index:9999;
      background:#4a90e2;
      width:60px;
      height:60px;
      border-radius:50%;
      box-shadow:0 4px 16px rgba(0,0,0,0.18);
      display:flex;
      align-items:center;
      justify-content:center;
      cursor:pointer;
      transition:box-shadow 0.2s;
    ">
      <span style="font-size:2em; color:#fff;">💬</span>
    </div>

    <!-- Chatbot Popup -->
    <div id="chatbot-popup" style="
      position:fixed;
      bottom:100px;
      right:32px;
      z-index:10000;
      width:320px;
      background:#f0f4f8;
      border-radius:16px;
      box-shadow:0 8px 32px rgba(0,0,0,0.18);
      padding:18px;
      display:none;
    ">
      <h3 style="color:#357abd; margin-top:0;">AI Chatbot</h3>
      <div id="chatbot-window" style="height:140px; overflow-y:auto; background:#fff; border-radius:8px; border:1px solid #e0e0e0; padding:10px; margin-bottom:10px; font-size:0.98em;"></div>
      <div style="display:flex;">
        <input id="chatbot-input" type="text" placeholder="Ask me about your meal plan, calories, BMI..." style="flex:1; padding:8px; border-radius:6px; border:1px solid #4a90e2;">
        <button onclick="sendChatbotMessage()" style="margin-left:8px; background:#4a90e2; color:#fff; border:none; border-radius:6px; padding:8px 16px; cursor:pointer;">Send</button>
      </div>
    </div>

    <script>
    document.getElementById('startCalcBtn').onclick = function() {
        var container = document.getElementById('calculatorContainer');
        document.querySelector('.hero').style.display = 'none';
        document.querySelector('.features-section').style.display = 'none';
        document.querySelector('.how-it-works-section').style.display = 'none';
        document.querySelector('header').style.display = 'none';
        document.querySelector('footer').style.display = 'none';
        fetch('calcu.html')
            .then(response => response.text())
            .then(html => {
                container.innerHTML = html;
                container.style.display = 'block';
                setTimeout(function() {
                    container.style.opacity = 1;
                    container.scrollIntoView({behavior: 'smooth'});
                }, 50);
                loadCalculatorScript();
            });
    };

    function loadCalculatorScript() {
        var script = document.createElement('script');
        script.src = 'calcu.js';
        document.body.appendChild(script);
    }

    // Floating chatbot icon toggle
    const chatbotFloat = document.getElementById('chatbot-float');
    const chatbotPopup = document.getElementById('chatbot-popup');
    chatbotFloat.onclick = function() {
      chatbotPopup.style.display = chatbotPopup.style.display === 'none' ? 'block' : 'none';
    };

    // Optional: Close popup when clicking outside
    document.addEventListener('click', function(e) {
      if (
        chatbotPopup.style.display === 'block' &&
        !chatbotPopup.contains(e.target) &&
        !chatbotFloat.contains(e.target)
      ) {
        chatbotPopup.style.display = 'none';
      }
    });

    // --- Simple AI Chatbot ---
    function sendChatbotMessage() {
      const input = document.getElementById('chatbot-input');
      const windowEl = document.getElementById('chatbot-window');
      const userMsg = input.value.trim();
      if (!userMsg) return;
      windowEl.innerHTML += `<div style="margin-bottom:6px;"><b>You:</b> ${userMsg}</div>`;
      input.value = '';

      // Expanded keyword-based responses for nutrition questions
      let response = "I'm here to help! Ask me about your meal plan, calories, BMI, or nutrition facts.";
      if (/bmi|body mass/i.test(userMsg)) {
        response = `Your BMI is <b>${typeof bmi !== 'undefined' ? bmi : 'calculated based on your profile'}</b>.`;
      } else if (/calorie|calories/i.test(userMsg)) {
        response = `Your daily meal plan ranges from <b>950</b> to <b>1010</b> kcal depending on the day.`;
      } else if (/meal plan|breakfast|lunch|dinner/i.test(userMsg)) {
        if (typeof weeklyMealPlans !== 'undefined' && typeof daySelector !== 'undefined') {
          const dayIdx = document.getElementById('daySelector').selectedIndex;
          const plan = weeklyMealPlans[dayIdx];
          response = `<b>Breakfast:</b> ${plan.breakfast}<br><b>Lunch:</b> ${plan.lunch}<br><b>Dinner:</b> ${plan.dinner}<br><i>Total: ~${plan.total} kcal</i>`;
        } else {
          response = "Meal plan details are available in your profile section.";
        }
      } else if (/protein|carb|fat|nutrient|nutrition|vitamin|mineral/i.test(userMsg)) {
        response = "Nutrition facts vary by food. For example, chicken breast is high in protein, rice is rich in carbohydrates, and avocado contains healthy fats. Ask about a specific food for more details!";
      } else if (/apple|banana|chicken|rice|salmon|egg|milk|beef|tofu|pasta|cheese|bread|yogurt|shrimp|cod|potato|vegetable|fruit/i.test(userMsg)) {
        // Example nutritional facts for some foods
        const facts = {
          apple: "An apple (100g) contains ~52 kcal, 0.3g protein, 14g carbs, 0.2g fat.",
          banana: "A banana (100g) contains ~89 kcal, 1.1g protein, 23g carbs, 0.3g fat.",
          chicken: "Chicken breast (100g) contains ~165 kcal, 31g protein, 0g carbs, 3.6g fat.",
          rice: "Cooked white rice (100g) contains ~130 kcal, 2.7g protein, 28g carbs, 0.3g fat.",
          salmon: "Salmon (100g) contains ~208 kcal, 20g protein, 0g carbs, 13g fat.",
          egg: "Egg (1 large) contains ~72 kcal, 6g protein, 0.4g carbs, 5g fat.",
          milk: "Milk (100ml) contains ~42 kcal, 3.4g protein, 5g carbs, 1g fat.",
          beef: "Beef (100g) contains ~250 kcal, 26g protein, 0g carbs, 17g fat.",
          tofu: "Tofu (100g) contains ~76 kcal, 8g protein, 1.9g carbs, 4.8g fat.",
          pasta: "Cooked pasta (100g) contains ~131 kcal, 5g protein, 25g carbs, 1g fat.",
          cheese: "Cheddar cheese (100g) contains ~402 kcal, 25g protein, 1.3g carbs, 33g fat.",
          bread: "White bread (1 slice, ~25g) contains ~67 kcal, 2g protein, 13g carbs, 1g fat.",
          yogurt: "Plain yogurt (100g) contains ~59 kcal, 10g protein, 3.6g carbs, 0.4g fat.",
          shrimp: "Shrimp (100g) contains ~99 kcal, 24g protein, 0.2g carbs, 0.3g fat.",
          cod: "Cod (100g) contains ~82 kcal, 18g protein, 0g carbs, 0.7g fat.",
          potato: "Potato (100g) contains ~77 kcal, 2g protein, 17g carbs, 0.1g fat.",
          vegetable: "Vegetables vary, but are generally low in calories and high in vitamins and minerals.",
          fruit: "Fruits are rich in vitamins, minerals, and fiber, and usually low in fat."
        };
        for (const key in facts) {
          if (userMsg.toLowerCase().includes(key)) {
            response = facts[key];
            break;
          }
        }
      } else if (/hello|hi|hey/i.test(userMsg)) {
        response = "Hello! How can I assist you with your nutrition today?";
      }
      windowEl.innerHTML += `<div style="margin-bottom:10px; color:#357abd;"><b>AI:</b> ${response}</div>`;
      windowEl.scrollTop = windowEl.scrollHeight;
    }
    </script>
</body>
</html>
