<script>
/* =========================
   Your original JS (kept intact)
   with only visual message wrappers
   so chat messages show as bubbles.
   ========================= */

let items = [];

function appendValue(calories, label) {
    let idx = items.findIndex(item => item.label === label);
    if (idx > -1) {
        items[idx].quantity += 1;
    } else {
        items.push({
            label: label,
            calories: calories,
            grams: 100,
            quantity: 1,
            image: getImagePath(label)
        });
    }
    renderTable();
}

function clearDisplay() {
    items = [];
    renderTable();
}

function increaseQuantity(index) {
    items[index].quantity += 1;
    renderTable();
}

function decreaseQuantity(index) {
    if (items[index].quantity > 1) {
        items[index].quantity -= 1;
    } else {
        items.splice(index, 1);
    }
    renderTable();
}

function updateGrams(index, newGrams) {
    items[index].grams = parseInt(newGrams) || 100;
    renderTable();
}

function filterItems() {
    const search = document.getElementById('searchBar').value.toLowerCase();
    const buttons = document.querySelectorAll('#buttonsContainer button');
    buttons.forEach(btn => {
        const text = btn.textContent.toLowerCase();
        const alt = btn.querySelector('img') ? btn.querySelector('img').alt.toLowerCase() : '';
        btn.style.display = (text.includes(search) || alt.includes(search)) ? '' : 'none';
    });
}

function renderTable() {
    const tbody = document.getElementById('tableBody');
    tbody.innerHTML = '';
    let total = 0;
    items.forEach((item, idx) => {
        const cal = ((item.calories / 100) * item.grams) * item.quantity;
        total += cal;
        const row = document.createElement('tr');
        row.innerHTML = `
            <td><img src="${item.image}" alt="${item.label}" style="width:40px;height:40px;border-radius:8px;"></td>
            <td>${item.label}</td>
            <td>
                <input type="number" min="1" value="${item.grams}" style="width:60px; background:transparent; color:var(--text); border:1px solid var(--border); padding:6px; border-radius:6px;" onchange="updateGrams(${idx}, this.value)">
            </td>
            <td>${item.quantity}</td>
            <td>${cal.toFixed(1)}</td>
            <td><button onclick="decreaseQuantity(${idx})" class="small-btn">-</button></td>
            <td><button onclick="increaseQuantity(${idx})" class="small-btn">+</button></td>
        `;
        tbody.appendChild(row);
    });
    document.getElementById('totalCalories').textContent = 'Total Calories: ' + total.toFixed(1);
}

function getImagePath(label) {
    const images = {
        'Apple': 'Food images/Apple Image.png',
        'Banana': 'Food images/Banana Image.png',
        'Burger': 'Food images/Burger Image.png',
        'Pizza': 'Food images/Pizza Slice Image.png',
        'Salad': 'Food images/Salad Bowl Image.png',
        'Sandwich': 'Food images/Sandwich Image.png',
        'Orange': 'Food images/Orange Image.png',
        'Egg': 'Food images/Egg Image.png',
        'Milk': 'Food images/Milk Carton Image.png',
        'FrenchFries': 'Food images/French Fries Image.png',
        'Chicken': 'Food images/Cooked Chicken Image.png',
        'Beef': 'Food images/Cooked Beef Image.png',
        'IceCream': 'Food images/Ice Cream Scoop Image.png',
        'Tofu': 'Food images/Tofu Block Image.png',
        'Pasta': 'Food images/Pasta Dish Image.png',
        'Cheese': 'Food images/Cheese Block Image.png',
        'Rice': 'Food images/Cooked Rice Image.png',
        'Bread': 'Food images/Bread Loaf Image.png',
        'Papaya': 'Food images/Papaya Slice Image.png',
        'Mushroom': 'Food images/Mushroom Image.png',
        'Avocado': 'Food images/Avocado Half Image.png',
        'Yogurt': 'Food images/Yogurt Cup Image.png',
        'Salmon': 'Food images/Salmon Fillet Image.png'
    };
    return images[label] || '';
}

function getMealPlan(goal, calorieIntake) {
    if (goal === 'Lose Weight') {
        return `
        <b>Breakfast:</b> Oatmeal with Banana (200 kcal)<br>
        <b>Lunch:</b> Grilled Chicken Salad (350 kcal)<br>
        <b>Dinner:</b> Salmon, Rice & Veggies (400 kcal)<br>
        <i>Total: ~${calorieIntake} kcal</i>
        `;
    } else if (goal === 'Gain Weight') {
        return `
        <b>Breakfast:</b> Eggs & Toast (350 kcal)<br>
        <b>Lunch:</b> Beef Sandwich & Cheese (500 kcal)<br>
        <b>Dinner:</b> Pasta with Chicken (600 kcal)<br>
        <i>Total: ~${calorieIntake} kcal</i>
        `;
    } else {
        return `
        <b>Breakfast:</b> Yogurt & Fruit (250 kcal)<br>
        <b>Lunch:</b> Tofu Salad & Bread (400 kcal)<br>
        <b>Dinner:</b> Rice, Salmon & Veggies (450 kcal)<br>
        <i>Total: ~${calorieIntake} kcal</i>
        `;
    }
}

function showMealPlan() {
    // Example profile data (replace with dynamic data if available)
    const heightCm = 175;
    const weightKg = 72;
    const goal = 'Lose Weight';

    // BMI Calculation
    const heightM = heightCm / 100;
    const bmi = (weightKg / (heightM * heightM)).toFixed(1);

    // Calorie Intake Suggestion
    let calorieIntake;
    if (goal === 'Lose Weight') {
        calorieIntake = Math.max(1200, Math.round(22 * weightKg));
    } else if (goal === 'Gain Weight') {
        calorieIntake = Math.round(30 * weightKg);
    } else {
        calorieIntake = Math.round(25 * weightKg);
    }

    // BMI Info
    let bmiStatus = '';
    if (bmi < 18.5) bmiStatus = 'Underweight';
    else if (bmi < 25) bmiStatus = 'Normal';
    else if (bmi < 30) bmiStatus = 'Overweight';
    else bmiStatus = 'Obese';

    // Show BMI inside profile
    document.getElementById('bmiInfoProfile').innerHTML = `BMI: <b>${bmi}</b> (${bmiStatus})`;
    // Show calorie intake and meal plan below profile
    document.getElementById('calorieIntake').innerHTML = `Recommended Daily Calories: <b>${calorieIntake} kcal</b>`;
    document.getElementById('mealPlanSuggestion').innerHTML = getMealPlan(goal, calorieIntake);
}

const fastFoods = [
  'Burger', 'Pizza', 'FrenchFries', 'Sandwich', 'IceCream'
];
const cookedMeals = [
  'Apple', 'Banana', 'Salad', 'Orange', 'Egg', 'Milk', 'Chicken', 'Beef', 'Tofu', 'Pasta', 'Cheese', 'Rice', 'Bread', 'Papaya', 'Mushroom', 'Avocado', 'Yogurt', 'Salmon'
];

function showCategory(category) {
  const buttons = document.querySelectorAll('#buttonsContainer button');
  buttons.forEach(btn => {
    const label = btn.textContent.trim();
    if (category === 'fast') {
      btn.style.display = fastFoods.includes(label) ? '' : 'none';
    } else {
      btn.style.display = cookedMeals.includes(label) ? '' : 'none';
    }
  });
  // Highlight active tab
  const fastBtn = document.getElementById('fastFoodTab');
  const cookedBtn = document.getElementById('cookedMealTab');
  if (category === 'fast') {
    fastBtn.classList.add('active'); cookedBtn.classList.remove('active');
  } else {
    cookedBtn.classList.add('active'); fastBtn.classList.remove('active');
  }
}

// Show all by default on load
window.onload = function() {
  document.getElementById('searchBar').focus();
  renderTable();
  showMealPlan();
  showCategory('fast'); // Default to fast foods
};

  // Floating chatbot icon toggle
  const chatbotFloat = document.getElementById('chatbot-float');
  const chatbotPopup = document.getElementById('chatbot-popup');
  chatbotFloat.onclick = function() {
    chatbotPopup.style.display = chatbotPopup.style.display === 'none' ? 'block' : 'none';
  };

  // Optional: Close popup when clicking outside
  document.addEventListener('click', function(e) {
    if (
      chatbotPopup.style.display === 'block' &&
      !chatbotPopup.contains(e.target) &&
      !chatbotFloat.contains(e.target)
    ) {
      chatbotPopup.style.display = 'none';
    }
  });

  // --- Simple AI Chatbot ---
  function sendChatbotMessage() {
    const input = document.getElementById('chatbot-input');
    const windowEl = document.getElementById('chatbot-window');
    const userMsg = input.value.trim();
    if (!userMsg) return;

    // append user bubble
    const userHtml = `<div class="chat-message chat-user"><span class="chat-label">You:</span> ${escapeHtml(userMsg)}</div>`;
    windowEl.innerHTML += userHtml;
    input.value = '';

    // Expanded keyword-based responses for nutrition questions
    let response = "I'm here to help! Ask me about your meal plan, calories, BMI, or nutrition facts.";
    if (/bmi|body mass/i.test(userMsg)) {
      response = `Your BMI is <b>${typeof bmi !== 'undefined' ? bmi : 'calculated based on your profile'}</b>.`;
    } else if (/calorie|calories/i.test(userMsg)) {
      response = `Your daily meal plan ranges from <b>950</b> to <b>1010</b> kcal depending on the day.`;
    } else if (/meal plan|breakfast|lunch|dinner/i.test(userMsg)) {
      if (typeof weeklyMealPlans !== 'undefined' && typeof daySelector !== 'undefined') {
        const dayIdx = document.getElementById('daySelector').selectedIndex;
        const plan = weeklyMealPlans[dayIdx];
        response = `<b>Breakfast:</b> ${plan.breakfast}<br><b>Lunch:</b> ${plan.lunch}<br><b>Dinner:</b> ${plan.dinner}<br><i>Total: ~${plan.total} kcal</i>`;
      } else {
        response = "Meal plan details are available in your profile section.";
      }
    } else if (/protein|carb|fat|nutrient|nutrition|vitamin|mineral/i.test(userMsg)) {
      response = "Nutrition facts vary by food. For example, chicken breast is high in protein, rice is rich in carbohydrates, and avocado contains healthy fats. Ask about a specific food for more details!";
    } else if (/apple|banana|chicken|rice|salmon|egg|milk|beef|tofu|pasta|cheese|bread|yogurt|shrimp|cod|potato|vegetable|fruit/i.test(userMsg)) {
      // Example nutritional facts for some foods
      const facts = {
        apple: "An apple (100g) contains ~52 kcal, 0.3g protein, 14g carbs, 0.2g fat.",
        banana: "A banana (100g) contains ~89 kcal, 1.1g protein, 23g carbs, 0.3g fat.",
        chicken: "Chicken breast (100g) contains ~165 kcal, 31g protein, 0g carbs, 3.6g fat.",
        rice: "Cooked white rice (100g) contains ~130 kcal, 2.7g protein, 28g carbs, 0.3g fat.",
        salmon: "Salmon (100g) contains ~208 kcal, 20g protein, 0g carbs, 13g fat.",
        egg: "Egg (1 large) contains ~72 kcal, 6g protein, 0.4g carbs, 5g fat.",
        milk: "Milk (100ml) contains ~42 kcal, 3.4g protein, 5g carbs, 1g fat.",
        beef: "Beef (100g) contains ~250 kcal, 26g protein, 0g carbs, 17g fat.",
        tofu: "Tofu (100g) contains ~76 kcal, 8g protein, 1.9g carbs, 4.8g fat.",
        pasta: "Cooked pasta (100g) contains ~131 kcal, 5g protein, 25g carbs, 1g fat.",
        cheese: "Cheddar cheese (100g) contains ~402 kcal, 25g protein, 1.3g carbs, 33g fat.",
        bread: "White bread (1 slice, ~25g) contains ~67 kcal, 2g protein, 13g carbs, 1g fat.",
        yogurt: "Plain yogurt (100g) contains ~59 kcal, 10g protein, 3.6g carbs, 0.4g fat.",
        shrimp: "Shrimp (100g) contains ~99 kcal, 24g protein, 0.2g carbs, 0.3g fat.",
        cod: "Cod (100g) contains ~82 kcal, 18g protein, 0g carbs, 0.7g fat.",
        potato: "Potato (100g) contains ~77 kcal, 2g protein, 17g carbs, 0.1g fat.",
        vegetable: "Vegetables vary, but are generally low in calories and high in vitamins and minerals.",
        fruit: "Fruits are rich in vitamins, minerals, and fiber, and usually low in fat."
      };
      for (const key in facts) {
        if (userMsg.toLowerCase().includes(key)) {
          response = facts[key];
          break;
        }
      }
    } else if (/hello|hi|hey/i.test(userMsg)) {
      response = "Hello! How can I assist you with your nutrition today?";
    }

    // append bot bubble
    const botHtml = `<div class="chat-message chat-bot"><span class="chat-label">AI:</span> ${response}</div>`;
    windowEl.innerHTML += botHtml;
    windowEl.scrollTop = windowEl.scrollHeight;
  }

  // small helper: escape HTML in user input for safety / display
  function escapeHtml(unsafe) {
    return unsafe
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }
