<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Calories Calculator — Dark Mode</title>

  <!-- Poppins font -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

  <style>
    /* ========== Color system (dark mode) ========== */
    :root{
      --bg: #0d1117;            /* page background */
      --card: #161b22;          /* card background */
      --muted-card: #0f1418;
      --text: #e6edf3;          /* main text */
      --subtext: #b6c2c7;       /* secondary text */
      --accent: #3fb950;        /* main green */
      --accent-strong: #238636; /* hover/active green */
      --border: #30363d;
      --glass: rgba(255,255,255,0.02);
      --soft-shadow: 0 6px 18px rgba(2,6,23,0.6);
      --glass-border: rgba(255,255,255,0.03);
      --muted-btn: rgba(255,255,255,0.04);
    }

    /* ========== Base ========== */
    * { box-sizing: border-box; }
    html,body { height:100%; margin:0; padding:0; }
    body {
      font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
      background: linear-gradient(180deg,var(--bg), #071018 60%);
      color: var(--text);
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
      animation: pageFade 400ms ease both;
      padding-bottom: 48px;
    }

    @keyframes pageFade {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    a { color: inherit; text-decoration: none; }

    /* ========== Header ========== */
    header {
      background: linear-gradient(180deg, rgba(255,255,255,0.02), transparent);
      border-bottom: 1px solid var(--border);
      padding: 18px 0 10px 0;
      text-align: center;
      margin-bottom: 0;
      backdrop-filter: blur(6px);
    }
    header h1 {
      font-size: 2.2em;
      color: var(--text);
      margin: 0;
      letter-spacing: 1px;
      font-weight: 600;
    }
    header p { color: var(--subtext); font-size:1.02em; margin:8px 0 0 0; }

    /* ========== Profile Section ========== */
    .profile-section {
      background: linear-gradient(90deg, rgba(63,185,80,0.06), rgba(63,185,80,0.02));
      padding: 22px 0 16px 0;
      text-align: center;
      border-bottom: 1px solid var(--border);
    }
    .profile-card {
      display: inline-flex;
      align-items: center;
      gap: 18px;
      background: linear-gradient(180deg, var(--card), var(--muted-card));
      border-radius: 14px;
      box-shadow: var(--soft-shadow);
      padding: 14px 26px;
      border: 1px solid var(--glass-border);
      color: var(--text);
    }
    .profile-card img {
      width:70px; height:70px; border-radius:50%;
      border: 3px solid rgba(63,185,80,0.14);
      background: linear-gradient(180deg, rgba(255,255,255,0.02), transparent);
    }
    .profile-card-info { text-align:left; }
    .profile-card-info .name { font-size:1.18em; font-weight:700; color:var(--text); }
    .profile-card-info .goal { color: var(--accent); font-weight:600; margin-top:6px; }
    .profile-card-info .details { color: var(--subtext); font-size:0.95em; margin-top:6px; }

    /* ========== Center container / Calculator ========== */
    .calculator-container {
      max-width: 1100px;
      margin: 32px auto 24px;
      background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.00));
      border-radius: 14px;
      padding: 28px;
      border: 1px solid var(--glass-border);
      box-shadow: 0 10px 32px rgba(2,6,23,0.65);
      display: block;
    }

    .calculator { display:flex; flex-wrap:wrap; gap:28px; }

    /* Left column (controls) */
    .calculator > div:first-child { flex:1; min-width:320px; }

    /* Right column (display) */
    .calculator > div:last-child { flex:2; min-width:340px; }

    /* ========== Search input ========== */
    #searchBar {
      font-size: 1.05em;
      color: var(--text);
      background: var(--muted-btn);
      padding: 12px;
      border-radius: 10px;
      border: 1px solid var(--border);
      margin-bottom: 14px;
      width: 100%;
      box-sizing: border-box;
      outline: none;
      transition: border-color 160ms ease, box-shadow 160ms ease;
    }
    #searchBar:focus {
      border-color: rgba(63,185,80,0.6);
      box-shadow: 0 6px 20px rgba(63,185,80,0.06);
    }
    #searchBar::placeholder { color: #93a3a6; opacity:0.9; }

    /* ========== Tabs ========== */
    .tabs { margin-bottom: 14px; }
    .tabs button {
      background: transparent;
      color: var(--subtext);
      border: 1px solid transparent;
      padding: 10px 18px;
      border-radius: 10px;
      cursor: pointer;
      font-weight:600;
      margin-right:8px;
      transition: all 180ms ease;
    }
    .tabs button.active {
      color: var(--text);
      background: linear-gradient(90deg, rgba(63,185,80,0.12), rgba(63,185,80,0.06));
      box-shadow: 0 6px 20px rgba(63,185,80,0.06);
      border: 1px solid rgba(63,185,80,0.12);
    }

    /* ========== Food buttons grid ========== */
    #buttonsContainer {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.00));
      border-radius: 12px;
      padding: 12px;
      border: 1px solid var(--border);
      max-height: 320px;
      overflow-y:auto;
    }

    #buttonsContainer button {
      background: var(--card);
      color: var(--text);
      border: 1px solid var(--glass-border);
      border-radius: 10px;
      padding: 12px 8px;
      font-size: 0.98em;
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:8px;
      cursor:pointer;
      transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
      box-shadow: 0 6px 14px rgba(2,6,23,0.5);
    }
    #buttonsContainer button:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 30px rgba(63,185,80,0.06);
      border-color: rgba(63,185,80,0.12);
    }
    #buttonsContainer img { width:48px; height:48px; border-radius:8px; }

    /* ========== Display table ========== */
    .display {
      overflow-y:auto;
      max-height: 400px;
      border-radius: 12px;
      padding: 14px;
      background: linear-gradient(180deg,var(--card),var(--muted-card));
      border: 1px solid var(--glass-border);
      box-shadow: 0 12px 34px rgba(2,6,23,0.6);
    }
    .display table { width:100%; border-collapse:collapse; color:var(--text); }
    .display th {
      background: transparent;
      color: var(--subtext);
      padding:12px;
      text-align:left;
      font-weight:600;
      border-bottom: 1px solid var(--border);
    }
    .display td {
      padding:10px;
      border-bottom:1px solid rgba(255,255,255,0.02);
      vertical-align:middle;
      color:var(--text);
    }
    .display tr:hover { background: rgba(63,185,80,0.02); }

    /* ========== Total + Clear ========== */
    .total {
      font-size:1.45em;
      color: var(--text);
      background: linear-gradient(180deg, rgba(255,255,255,0.01), transparent);
      padding: 16px;
      border-radius:10px;
      margin-bottom:12px;
      border:1px solid var(--glass-border);
      text-align:center;
      box-shadow: 0 8px 24px rgba(2,6,23,0.6);
    }

    .clear {
      background: linear-gradient(90deg, #2f6b22, #3fb950);
      color: white;
      border:none;
      padding:12px 30px;
      border-radius:10px;
      cursor:pointer;
      font-size:1em;
      box-shadow: 0 10px 30px rgba(63,185,80,0.12);
      transition: transform 160ms ease, box-shadow 160ms ease;
    }
    .clear:hover { transform: translateY(-6px); box-shadow: 0 16px 48px rgba(63,185,80,0.16); }

    /* +/- small buttons in table */
    .small-btn {
      background: linear-gradient(90deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
      color: var(--text);
      border:1px solid var(--border);
      padding:6px 10px;
      border-radius:6px;
      cursor:pointer;
    }

    /* ========== Chatbot (floating) ========== */
    #chatbot-float {
      position: fixed;
      bottom: 32px;
      right: 32px;
      z-index: 9999;
      background: linear-gradient(90deg, var(--accent), var(--accent-strong));
      width: 60px;
      height: 60px;
      border-radius: 50%;
      box-shadow: 0 12px 30px rgba(63,185,80,0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform 160ms ease, box-shadow 160ms ease;
      border: 1px solid rgba(255,255,255,0.04);
    }
    #chatbot-float:hover { transform: translateY(-6px); box-shadow: 0 18px 48px rgba(63,185,80,0.16); }

    #chatbot-popup {
      position: fixed;
      bottom: 100px;
      right: 32px;
      z-index: 10000;
      width: 340px;
      background: linear-gradient(180deg, var(--card), var(--muted-card));
      border-radius: 14px;
      box-shadow: 0 18px 48px rgba(2,6,23,0.7);
      padding: 16px;
      display: none;
      border: 1px solid var(--glass-border);
    }
    #chatbot-popup h3 { color: var(--text); margin-top:0; margin-bottom:8px; font-size:1.05em; }

    #chatbot-window {
      height: 160px;
      overflow-y: auto;
      background: linear-gradient(180deg, rgba(255,255,255,0.01), transparent);
      border-radius: 10px;
      border: 1px solid var(--border);
      padding: 10px;
      margin-bottom: 10px;
      font-size:0.95em;
      color: var(--text);
    }

    /* Chat message bubbles */
    .chat-message { display:block; margin-bottom:10px; max-width:88%; word-wrap:break-word; }
    .chat-user {
      background: var(--border);
      color: var(--text);
      padding:10px 12px;
      border-radius:12px;
      align-self:flex-end;
      margin-left:auto;
      border: 1px solid rgba(255,255,255,0.02);
      box-shadow: 0 6px 18px rgba(0,0,0,0.5);
      font-weight:500;
    }
    .chat-bot {
      background: linear-gradient(90deg, rgba(63,185,80,0.12), rgba(63,185,80,0.06));
      color: var(--text);
      padding:10px 12px;
      border-radius:12px;
      margin-right:auto;
      border: 1px solid rgba(63,185,80,0.10);
      box-shadow: 0 6px 18px rgba(63,185,80,0.04);
      font-weight:500;
    }
    .chat-label { font-weight:700; margin-right:6px; color:var(--subtext); }

    /* Chat input & send */
    #chatbot-input {
      flex:1;
      padding:8px 10px;
      border-radius:8px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--text);
      outline: none;
    }
    #chatbot-input::placeholder { color:#93a3a6; }

    #chatbot-popup button.send-btn {
      margin-left:8px;
      background: linear-gradient(90deg,var(--accent),var(--accent-strong));
      color: white;
      border:none;
      border-radius:8px;
      padding:8px 14px;
      cursor:pointer;
      box-shadow: 0 8px 26px rgba(63,185,80,0.12);
    }

    /* ========== Day selector override ========== */
    #daySelector {
      margin-top: 12px;
      margin-bottom: 24px;
      padding: 10px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: transparent;
      font-size: 1em;
      color: var(--text);
      cursor: pointer;
    }

    /* ========== Responsive tweaks ========== */
    @media (max-width:900px) {
      .calculator { flex-direction: column; }
      #buttonsContainer { grid-template-columns: repeat(2,1fr); }
      #chatbot-popup { right: 18px; left: 18px; width: auto; bottom: 90px; }
      .calculator-container { margin: 20px 16px; padding:18px; }
    }
  </style>
</head>
<body>

<!-- Header -->
<header>
